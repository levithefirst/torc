# Torc environment. Copy to .env.local for local dev. Placeholders only: never commit real values.

# --- Network: chipnet (default) or mainnet. Everything else switches from this. ---
NEXT_PUBLIC_NETWORK=chipnet

# The seeded demo circle for judge mode: the JSON of deployments/<network>.json.
# Optional on chipnet (the committed deployments/chipnet.json is used). Required on mainnet.
NEXT_PUBLIC_DEMO_CIRCLE=

# Electrum WSS servers, comma-separated, in failover order (hostname or host:port).
# Defaults: chipnet -> chipnet.bch.ninja,chipnet.imaginary.cash ; mainnet -> bch.imaginary.cash,electrum.imaginary.cash,bch.loping.net
NEXT_PUBLIC_ELECTRUM_WSS=

# Explorer tx URL prefix (txid is appended).
# Defaults: chipnet -> https://chipnet.imaginary.cash/tx/ ; mainnet -> https://explorer.bitcoinunlimited.info/tx/
NEXT_PUBLIC_EXPLORER_TX=

NEXT_PUBLIC_REPO_URL=https://github.com/levithefirst/torc
# The Widget Factory deck (Google Slides share link). Until set, the banner links /deck.
NEXT_PUBLIC_DECK_URL=
# Token-aware (z... / bitcoincash:z...) donation + EMBER2026 Community-Choice address. Throwaway, Fluid's choice.
NEXT_PUBLIC_DONATION_ADDRESS=
NEXT_PUBLIC_SITE_URL=https://torc-brown.vercel.app

# --- Server only (Vercel encrypted env). Never in git, chat, logs or the browser bundle. ---
# Seed for the THROWAWAY demo seat keys (>= 32 random chars). Keys are derived on the server.
DEMO_SEED=<set-in-vercel-only>
# Alternative to DEMO_SEED: comma-separated throwaway WIFs.
DEMO_SEAT_WIFS=<set-in-vercel-only>
# Bearer token for scheduled GET /api/demo/tick.
CRON_SECRET=<set-in-vercel-only>

# --- Scripts only ---
# Mainnet PUSD (ParyonUSD) category, 2 decimals. Verified 18 Nov 2026 on paryonusd.com
# (homepage "PUSD Token ID" and blog/launch "PUSD has 2 decimal places").
PUSD_CATEGORY=2469acc5afa4b10cb5b5c04afb89c3a3ffd61c5da9c01e26d00951cae2a02544
# Use a deployed /api/chain relay instead of direct Electrum WSS (sandboxes without WSS egress).
TORC_RELAY_URL=
